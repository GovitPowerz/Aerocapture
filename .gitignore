# === macOS ===
.DS_Store

# === Python ===
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.mypy_cache/
.pytest_cache/
.hypothesis/
.ruff_cache/

# === Rust ===
src/rust/target/

# === Build artifacts ===
*.o
*.mod
*.smod

# MATLAB binary data files (.mat)
*.mat

# === IDE / Editor ===
.vscode/
.idea/
*.swp
*.swo
*~

# === Claude Code ===
.claude/

# === Simulator output (regenerated by running) ===
output/*
!output/.gitkeep

# === Miscellaneous ===
*.json
!tests/reference_data/**/*.json
# Committed demo model (see models/demo/ and `uv run python -m aerocapture.demo`):
!models/demo/**/*.json
# Paper results bundle (collected by experiments/paper/12_collect_results.sh):
# the *.json rule above would silently drop best_model/best_params/final_selection.
!articles/paper/data/**/*.json
# Appendix per-scheme stats (read by appendix.typ at compile time — without
# these the paper does not build from a clean checkout).
!articles/paper/figures/appendix/**/*.json
*.temp
*.png
# Ignore training artifacts, EXCEPT the optimized reference trajectory:
# ref-tracking training configs point at it, so CI/e2e need it committed.
training_output/*
!training_output/mars/
training_output/mars/*
!training_output/mars/ref_trajectory.dat
data/neural_network/nn_model.json
# Raw paper training logs (195 MB): fetch with articles/paper/scripts/fetch_run_logs.sh
# (tarball attached to the arxiv-v2 GitHub Release). Everything else under data/runs stays tracked.
articles/paper/data/runs/**/*.jsonl.gz
# Local scratch (session notes, drafting material) — never tracked:
.scratch/
# Demo output (regenerated by `uv run python -m aerocapture.demo`):
demo_output/
*.pdf
# The compiled paper ships in-repo (linked from README; rebuild: typst compile articles/paper/paper.typ):
!articles/paper/paper.pdf
.superpowers/
